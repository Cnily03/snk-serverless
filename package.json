{
  "name": "snk-serverless",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "biome migrate --write",
    "dev:cf": "wrangler -c wrangler.local.toml dev",
    "deploy:cf": "wrangler -c wrangler.local.toml deploy",
    "tail:cf": "wrangler -c wrangler.local.toml tail snk",
    "dev:vercel": "vercel dev",
    "deploy:vercel": "bun --bun vercel --prod",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@snk/github-user-contribution": "file:./snk/packages/github-user-contribution",
    "@snk/solver": "file:./snk/packages/solver",
    "@snk/svg-creator": "file:./snk/packages/svg-creator",
    "@snk/types": "file:./snk/packages/types",
    "@upstash/redis": "^1.41.0",
    "@vercel/schedules": "^0.0.3",
    "hono": "^4.7.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@cloudflare/workers-types": "^4.20260220.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^25.3.3",
    "typescript": "^5.8.2",
    "vercel": "^50.27.1",
    "wrangler": "^4.6.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.0.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.17.0"
}
